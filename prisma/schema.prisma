
generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  verified  Boolean  @default(false)
  chats     Chat[]
  createdAt DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  role      String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}
